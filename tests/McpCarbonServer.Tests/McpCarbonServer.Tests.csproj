<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Single target, unlike the library's test project. The server ships as one net10.0
      executable, so there is no second framework leg for a regression to hide in.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    The tests drive the server as a real child process over stdio rather than calling the
    tool methods in-process. That is the whole point: it exercises the shipped executable,
    the stdio framing, the generated JSON schemas and the exception-to-error mapping in one
    path. It also makes stdout discipline self-testing - a stray write to stdout desyncs the
    framing, the client fails to parse, and every test here goes red.

    The path is passed in as assembly metadata because the server is launched, not linked,
    so there is no reference for the runtime to resolve it from.
  -->
  <PropertyGroup>
    <ServerAssemblyPath>$(MSBuildThisFileDirectory)../../src/McpCarbonServer/bin/$(Configuration)/net10.0/mcp-carbon-server.dll</ServerAssemblyPath>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ServerAssemblyPath</_Parameter1>
      <_Parameter2>$(ServerAssemblyPath)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Build ordering only; nothing from the server assembly is linked into the tests. -->
  <ItemGroup>
    <ProjectReference Include="../../src/McpCarbonServer/McpCarbonServer.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    No coverage collector, deliberately.

    The code under test runs in a child process — that is the point of these tests — while a
    collector instruments the test process. The server assembly is not even referenced here
    (ReferenceOutputAssembly is false above), so there is nothing for it to attach to.
    Running the XPlat Code Coverage collector produces a report with zero packages, and a
    report with zero packages presents as a line rate of 1. Wiring that into CI would publish
    a hundred percent that measures nothing, which is worse than publishing no figure at all.
    Cross-process collection via dotnet-coverage was tried and its profiler does not attach
    either.

    The trade is deliberate: these tests prove the shipped executable answers the protocol
    correctly, and the cost is that line coverage is not measurable from here.
  -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
