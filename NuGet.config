<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    <clear /> drops any feed inherited from the machine- or user-level NuGet.config.
    A public library must restore identically on a contributor's laptop and on a CI
    runner, and must never depend on a private feed the rest of the world cannot reach.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
